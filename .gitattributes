# z/OS: tag the files Open XL reads as ISO8859-1 so the ASCII character mode
# needs no conversion step, while history stays UTF-8.  Only ASCII-only files
# can take this: a character ISO8859-1 cannot represent, such as the em dash
# in README.md, makes `git clone` on z/OS fail at checkout.
* text=auto eol=lf
*.c         text zos-working-tree-encoding=iso8859-1 git-encoding=utf-8
*.h         text zos-working-tree-encoding=iso8859-1 git-encoding=utf-8
Makefile    text zos-working-tree-encoding=iso8859-1 git-encoding=utf-8
buildenv    text zos-working-tree-encoding=iso8859-1 git-encoding=utf-8
